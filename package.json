    "test:damage:d1": "node scripts/test-damage-d1.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.135.0"
  }
